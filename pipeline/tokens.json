{
  "$name": "Plumb",
  "$description": "Original design system for the Fleet Console. Source of truth; pipeline/theme.css mirrors it. Contrast ratios are computed against the named background (WCAG 2.x).",
  "color": {
    "primitive": {
      "n":      {"0":"#ffffff","50":"#f6f7f9","100":"#eef0f3","200":"#e1e4e9","300":"#cbd0d8","400":"#9aa2af","500":"#6b7482","550":"#626a78","600":"#4f5766","700":"#3a414e","750":"#2e3440","800":"#262b35","850":"#1d212a","900":"#171a21","950":"#0e1015","1000":"#0a0b0e"},
      "ink":    {"50":"#f0f4fe","100":"#e4ebfc","200":"#c6d4f9","400":"#8faaf5","500":"#4b77ea","600":"#2f5bd3","700":"#2447ae","900":"#14275f","950":"#18233f"},
      "red":    {"50":"#fdecea","200":"#ffb4ab","300":"#f28075","600":"#b42318","800":"#8f1b12","900":"#3a1512"},
      "amber":  {"50":"#fdf1d6","300":"#f5c25b","400":"#f2b134","600":"#b26a00","700":"#8a5300","900":"#3a2a08"},
      "teal":   {"50":"#e2f3f4","300":"#7dd3da","400":"#4fc3cc","700":"#0f6b73","900":"#0f2e31"},
      "violet": {"50":"#efe9fb","300":"#b79cf2","700":"#6d3fc4","900":"#2a1f4a"}
    },
    "semantic": {
      "light": {
        "canvas":"{n.50}","surface":"{n.0}","surface-sunken":"{n.100}","surface-raised":"{n.0}","surface-hover":"{n.100}","surface-selected":"{ink.50}",
        "fg":"{n.900}","fg-muted":"{n.600}","fg-subtle":"{n.550}","fg-on-accent":"{n.0}","fg-link":"{ink.600}",
        "line":"{n.200}","line-strong":"{n.500}","focus":"{ink.600}",
        "accent":"{ink.600}","accent-hover":"{ink.700}","accent-subtle":"{ink.100}","accent-subtle-fg":"{ink.700}",
        "sev1-mark":"{red.600}","sev1-fg":"{red.800}","sev1-bg":"{red.50}","sev1-line":"{red.600}","on-sev1":"{n.0}",
        "sev2-mark":"{amber.600}","sev2-fg":"{amber.700}","sev2-bg":"{amber.50}","sev2-line":"{amber.600}",
        "sev3-mark":"{teal.700}","sev3-fg":"{teal.700}","sev3-bg":"{teal.50}","sev3-line":"{teal.700}",
        "flag-fg":"{violet.700}","flag-bg":"{violet.50}","flag-line":"{violet.700}",
        "status-off":"#7f8b9f","status-on":"{n.600}","status-done":"{ink.600}"
      },
      "dark": {
        "canvas":"{n.950}","surface":"{n.900}","surface-sunken":"{n.1000}","surface-raised":"{n.800}","surface-hover":"{n.850}","surface-selected":"{ink.950}",
        "fg":"{n.100}","fg-muted":"{n.300}","fg-subtle":"{n.400}","fg-on-accent":"{n.950}","fg-link":"{ink.400}",
        "line":"{n.750}","line-strong":"{n.500}","focus":"{ink.400}",
        "accent":"{ink.400}","accent-hover":"{ink.200}","accent-subtle":"{ink.900}","accent-subtle-fg":"{ink.200}",
        "sev1-mark":"{red.300}","sev1-fg":"{red.200}","sev1-bg":"{red.900}","sev1-line":"{red.300}","on-sev1":"{n.950}",
        "sev2-mark":"{amber.400}","sev2-fg":"{amber.300}","sev2-bg":"{amber.900}","sev2-line":"{amber.600}",
        "sev3-mark":"{teal.400}","sev3-fg":"{teal.300}","sev3-bg":"{teal.900}","sev3-line":"{teal.400}",
        "flag-fg":"{violet.300}","flag-bg":"{violet.900}","flag-line":"{violet.300}",
        "status-off":"#626e84","status-on":"{n.300}","status-done":"{ink.400}"
      }
    },
    "rules": [
      "Hue is reserved: red/amber/teal = severity only; violet = flags only; ink = interaction, selection, 'done'. No green; Healthy and Verified are neutral/ink with a check glyph.",
      "Red also marks gaps (uncovered shift) but always with the hatch pattern, never a flat fill.",
      "Never use a sev* token outside severity, gap, or error contexts."
    ],
    "contrast": {
      "note": "Hand-computed WCAG ratios; builders must re-verify with a tool before Gate 2. AA targets: text >= 4.5, UI/graphics >= 3.",
      "light": [
        {"pair":"fg on canvas/surface","ratio":"~16:1"},
        {"pair":"fg-muted on canvas","ratio":"~7:1"},
        {"pair":"fg-subtle on surface-sunken","ratio":"~4.8:1"},
        {"pair":"line-strong on surface (controls)","ratio":"~4.7:1"},
        {"pair":"on-sev1 on sev1-mark","ratio":"~6.5:1"},
        {"pair":"sev1-fg on sev1-bg","ratio":"~8:1"},
        {"pair":"sev2-fg on sev2-bg","ratio":"~5.6:1"},
        {"pair":"sev3-fg on sev3-bg","ratio":"~5.4:1"},
        {"pair":"sev2-mark on surface (graphic)","ratio":"~4.2:1"},
        {"pair":"accent on surface","ratio":"~5.9:1"}
      ],
      "dark": [
        {"pair":"fg on surface","ratio":"~15:1"},
        {"pair":"fg-subtle on surface-raised","ratio":"~5.5:1"},
        {"pair":"line-strong on surface (controls)","ratio":"~3.7:1"},
        {"pair":"on-sev1 on sev1-mark","ratio":"~7:1"},
        {"pair":"sev1-fg on sev1-bg","ratio":"~10:1"},
        {"pair":"accent on surface","ratio":"~7.7:1"}
      ]
    }
  },
  "severity": {
    "$description": "One scale (SEV1-3) for tags, incidents, damage, data health, footage findings. Encoded by label + glyph shape + fill weight + hue. Any one channel alone is enough to tell the levels apart.",
    "levels": {
      "SEV1": {"label":"SEV1","glyph":"triangle-filled","fill":"solid","border":"none","weight":600,"edgeBar":"4px","response":"Immediate; auto-escalates"},
      "SEV2": {"label":"SEV2","glyph":"diamond-filled","fill":"tint","border":"1px solid","weight":600,"edgeBar":"3px","response":"Same shift; owner required"},
      "SEV3": {"label":"SEV3","glyph":"circle-ring","fill":"none","border":"1px solid","weight":500,"edgeBar":"none","response":"Batch review"}
    },
    "glyphs12": {
      "triangle-filled":"<path d='M6 1.5 11 10.5H1Z' fill='currentColor'/>",
      "diamond-filled":"<path d='M6 1 11 6 6 11 1 6Z' fill='currentColor'/>",
      "circle-ring":"<circle cx='6' cy='6' r='4' fill='none' stroke='currentColor' stroke-width='1.5'/>"
    },
    "dataHealthMapping": "Healthy = no chip (neutral check). Degraded = SEV3 chip. Failing = SEV2 chip, or SEV1 if a Drive is Active and the failing sensor is safety-relevant."
  },
  "status": {
    "$description": "One lifecycle for Incident, Damage/repair, Footage review. Encoded by label + a 5-segment bar (segments filled = step index). Never uses severity hues.",
    "steps": ["Captured","Triaged","Owned","Resolved","Verified"],
    "marker": {"segments":5,"segmentSize":"5x3","gap":"1px","verifiedGlyph":"check","verifiedColor":"status-done"},
    "flags": {
      "Escalated": {"glyph":"arrow-up-bar","token":"flag"},
      "Overdue":   {"glyph":"clock","token":"flag"},
      "Stale":     {"glyph":"hourglass-dashed","token":"flag"}
    },
    "rule": "Flags are additive pills beside the status; they are not states. Verified requires a person other than the resolver."
  },
  "type": {
    "family": {"sans":"Geist, ui-sans-serif, system-ui, sans-serif","mono":"Geist Mono, ui-monospace, monospace"},
    "features": {"body":"tnum","mono":"tnum, zero (slashed zero)","rule":"Tabular numerals are global. All numeric columns right-aligned. IDs, timestamps, coordinates in mono."},
    "scale": {
      "xs":  {"size":11,"line":16,"weight":500,"use":"caps labels, column headers (tracking 0.06em), footnotes"},
      "sm":  {"size":12,"line":16,"weight":400,"use":"secondary text, chips, meta"},
      "base":{"size":{"comfortable":14,"compact":13},"line":{"comfortable":20,"compact":18},"weight":400,"use":"body, table cells, inputs"},
      "md":  {"size":16,"line":24,"weight":500,"use":"pane titles"},
      "lg":  {"size":20,"line":28,"weight":600,"use":"page titles"},
      "xl":  {"size":28,"line":32,"weight":600,"use":"metric values","tracking":"-0.01em"},
      "2xl": {"size":40,"line":44,"weight":600,"use":"hero metric (Now debt total), escalation countdown","tracking":"-0.01em"}
    },
    "weights": [400,500,600]
  },
  "space": {
    "base": 4,
    "scale": [0,2,4,8,12,16,20,24,32,40,48,64],
    "note": "Tailwind --spacing is 4px, so p-3 = 12px."
  },
  "radius": {"xs":2,"sm":3,"md":5,"lg":8,"full":9999,
    "use": {"chips/badges":"sm","buttons/inputs":"sm","panes/cards":"md","popovers/dialogs":"lg","avatars/dots":"full"}},
  "elevation": {
    "0": {"use":"inline, table rows","light":"none","dark":"none"},
    "1": {"use":"sticky headers, tiles (with 1px line border)","light":"0 1px 0 rgb(14 16 21 / .04)","dark":"0 1px 0 rgb(0 0 0 / .4)"},
    "2": {"use":"menus, popovers, toasts","light":"0 4px 12px -2px rgb(14 16 21 / .14), 0 0 0 1px rgb(14 16 21 / .06)","dark":"0 6px 16px -2px rgb(0 0 0 / .55), 0 0 0 1px rgb(255 255 255 / .06)"},
    "3": {"use":"command palette, modal dialogs","light":"0 16px 40px -8px rgb(14 16 21 / .28), 0 0 0 1px rgb(14 16 21 / .08)","dark":"0 20px 48px -8px rgb(0 0 0 / .7), 0 0 0 1px rgb(255 255 255 / .08)"},
    "rule": "Layout is separated by 1px lines first; shadow only for things that float. In dark, floating surfaces also get surface-raised."
  },
  "motion": {
    "duration": {"instant":0,"fast":90,"base":150,"slow":240},
    "easing": {"standard":"cubic-bezier(0.2,0,0,1)","enter":"cubic-bezier(0,0,0,1)","exit":"cubic-bezier(0.3,0,1,1)"},
    "rules": [
      "Motion confirms an action or shows change of state; it never decorates.",
      "No motion on table row hover/selection (instant). Panes slide 150ms; palette fades 90ms.",
      "New live rows fade a 1-cycle background highlight (slow) and never reorder under the cursor.",
      "prefers-reduced-motion sets all durations to 0; the escalation countdown stays numeric."
    ]
  },
  "density": {
    "$description": "Two modes via [data-density]. Compact shrinks space and type by one step; it never hides information or drops targets below 24px (WCAG 2.2 target size).",
    "comfortable": {"row":36,"control":32,"padX":12,"gap":12,"pane":16,"textBase":14,"lineBase":20,"chip":22,"icon":16},
    "compact":     {"row":28,"control":26,"padX":8, "gap":8, "pane":12,"textBase":13,"lineBase":18,"chip":18,"icon":14},
    "defaultFor": {"lead (Now, Plan)":"comfortable","operator (Inbox, Review, Fleet)":"compact","note":"Per-user setting; ASSUMPTION, not validated."}
  },
  "layout": {"minWidth":1280,"nav":{"width":216,"collapsed":56},"splitPane":{"list":"minmax(360px,1fr)","detail":"minmax(420px,0.8fr)"},"zIndex":{"sticky":10,"popover":40,"modal":50,"toast":60}},
  "focus": {"ring":"2px solid {color.focus}","offset":2,"rule":"Visible on every interactive element, always (keyboard and programmatic focus). Never removed."}
}
